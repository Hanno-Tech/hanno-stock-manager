# =============================================================
# Desenvolvimento local (Docker: npm run db:up)
# =============================================================
DATABASE_URL="postgresql://estoque:estoque@localhost:5433/estoque_rapido"

# Segredo da sessão (gere: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3000"

# Storage de fotos — Vercel Blob (store `doca-fotos`).
# Não copie o token para cá: rode `vercel env pull` e ele chega no .env.local.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Cobrança — Asaas (assinatura de R$ 19,90/mês por agência).
# Sem a chave o app sobe e o cadastro funciona: a conta nasce com o teste
# grátis e a assinatura simplesmente não é aberta. Para desenvolver, use a
# chave do Sandbox (https://sandbox.asaas.com) — ela começa com $aact_hmlg_ e o
# cliente descobre o ambiente pelo prefixo.
# Escape os "$" com barra: o Next expande $VAR dentro do .env e sem isso a chave
# chega vazia no Asaas.
# ASAAS_API_KEY="\$aact_hmlg_..."
# Só para chave antiga, sem o prefixo padronizado: "sandbox" ou "production".
# ASAAS_ENV="sandbox"
# Token do webhook (32–255 caracteres, sem espaços). Gere: openssl rand -hex 24
# ASAAS_WEBHOOK_TOKEN="..."

# =============================================================
# Produção (Neon + Vercel Blob) — ver docs/DEPLOY.md
# =============================================================
# DATABASE_URL="postgresql://<user>:<pass>@<host>.neon.tech/neondb?sslmode=require"
# AUTH_SECRET="<openssl rand -base64 32>"
# AUTH_URL="https://seu-app.vercel.app"
# BLOB_READ_WRITE_TOKEN — a Vercel injeta sozinha ao vincular o Blob store.
# ASAAS_API_KEY="$aact_prod_..."   (Sensitive — no painel da Vercel não precisa escapar)
# ASAAS_WEBHOOK_TOKEN="<openssl rand -hex 24>"   (Sensitive)
